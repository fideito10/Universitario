# Copiar a .env (ignorado por git) y completar.
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST/DBNAME?sslmode=require

# Backend de lectura: sheets (default, comportamiento original) | postgres
DATA_BACKEND=sheets
# Solo con DATA_BACKEND=postgres: ademas de la DB, agrega los reportes medica/nutricion al Sheet (true|false)
MIRROR_WRITES_TO_SHEETS=false
